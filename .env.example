# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/samuel-louis-jean

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-random-string-here-min-32-chars

# Initial Admin Account (used for seeding)
ADMIN_EMAIL=admin@samuellouisjean.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Application Configuration
NODE_ENV=development

# Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/avif

# Site Configuration (required for Stripe redirect URLs)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_LOCALE=en

# Stripe Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook secret — for local dev run: npm run stripe:listen
# For production add webhook at: https://yourdomain.com/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMTP Configuration (Gmail App Password required)
# Create at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dr.louisjean@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=dr.louisjean@gmail.com
SMTP_TO=dr.louisjean@gmail.com
